+
+/*
+ * A reset (or the first command after take-over) leaves a pending UNIT
+ * ATTENTION: the device accepts the doorbell but leaves OCS at its 0x0F
+ * preset, so the command times out and every later command fails the same
+ * way. bootCB / F51-F52 proved that one plain re-submission consumes the UA
+ * and the SAME command then completes. Retry instead of failing the bio.
+ */
+#define UFS_MAX_TRIES  3u
+static int
+ufs_scsi_at(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write,
+    uint32_t bounce_off)
+{
+	int error = 0;
+
+	for (unsigned attempt = 0; attempt < UFS_MAX_TRIES; attempt++) {
+		error = ufs_scsi_once(cdb, cdb_len, len, write, bounce_off);
+		if (!error) {
+			return 0;
+		}
+		printf("SWEET UFS: retry 0x%02x attempt %u err %d len %u\n",
+		    cdb[0], attempt, error, len);
+	}
+	return error;
 }
 

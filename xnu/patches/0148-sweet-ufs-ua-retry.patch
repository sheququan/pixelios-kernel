+/* R5: the shim measured a 541 KiB single READ(10) with 68 x 8 KiB PRD
+ * entries completing in ~0.96 s (bootBS2 / F47), so splitting one bio into
+ * several <=64 KiB commands is unnecessary and gives the controller extra
+ * chances to leave a pending UNIT ATTENTION. Keep the loop in the block
+ * helpers but let one iteration cover the whole request. */
+#define PRDT_CMD_ENTRIES  (BOUNCE_SIZE / PRDT_ENTRY_MAX)        /* 128 */
+#define PRDT_CMD_BYTES    BOUNCE_SIZE                           /* 1 MiB */
+#define PRDT_CMD_BLOCKS   (PRDT_CMD_BYTES / UFS_BLOCK)          /* 256 blocks */
 _Static_assert(PRDT_CMD_BLOCKS > 0, "PRDT_CMD_BLOCKS must be non-zero");

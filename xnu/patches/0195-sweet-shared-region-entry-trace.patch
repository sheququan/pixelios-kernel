--- a/bsd/vm/vm_unix.c
+++ b/bsd/vm/vm_unix.c
@@ -2728,12 +2728,21 @@
 	proc_fdunlock(p);
 
 	/*
+	 * SWEET (R48): entry marker.  dyld only reaches this syscall when it
+	 * decided the shared region is empty and the shared cache therefore has
+	 * to be mapped; without this line a missing "SWEET SRMAP" cannot be told
+	 * apart from "the syscall failed before the success print".
+	 */
+	printf("SWEET SRMAP: enter files %u mappings %u\n", files_count, mappings_count);
+
+	/*
 	 * Turn files, mappings into sr_file_mappings and other setup.
 	 */
 	error = shared_region_map_and_slide_setup(p, files_count,
 	    files, mappings_count, mappings,
 	    &sr_file_mappings, &shared_region, rdir_vp);
 	if (error != 0) {
+		printf("SWEET SRMAP: setup err %d files %u\n", error, files_count);
 		vnode_put(rdir_vp);
 		return error;
 	}

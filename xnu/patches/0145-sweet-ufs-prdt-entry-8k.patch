+                                                 * 4/8 KiB ok, 16/32 KiB OCS). 1 MiB / 8 KiB
+                                                 * = 128 entries, which fits PRDT_MAX (256). */
+_Static_assert(BOUNCE_SIZE / PRDT_ENTRY_MAX <= PRDT_MAX,
+    "PRDT_MAX is too small for PRDT_ENTRY_MAX");

 #endif
 	bool is_user = PSR64_IS_USER(get_saved_state_cpsr(state));
+
+	/*
+	 * SWEET (R13): with code signing out of the way, launchd now runs and dies
+	 * with SIGILL a few instructions in:
+	 *   launchd[1] exited -- exit reason namespace 2 subcode 0x4
+	 * Nothing in the kernel reports where, and the screen is the only console,
+	 * so print every user synchronous exception with its PC. That tells a bad
+	 * instruction in a correctly mapped page (EC 0, pc inside __TEXT) from a
+	 * jump into unmapped or zeroed memory (IABORT/DABORT or pc outside).
+	 */
+	if (is_user) {
+		kprintf("SWEET EXC: thread %d pc %#llx esr %#x ec %u far %#llx\n",
+		    thread_tid(current_thread()),
+		    (unsigned long long)get_saved_state_pc(state), esr,
+		    (unsigned)class, (unsigned long long)far);
+	}
 

+	/*
+	 * SWEET (R13): the entry point and whether its page could be faulted in is
+	 * the difference between "the binary ran and hit a bad instruction" and
+	 * "the first instruction was never mapped". launchd dies with SIGILL right
+	 * after this, so say both out loud instead of behind DEBUG4K.
+	 */
+	printf("SWEET EXEC: %s entry %#llx prefault %d\n",
+	    imgp->ip_vp->v_name, (unsigned long long)load_result->entry_point, kr);
 	if (kr != KERN_SUCCESS) {
 		DEBUG4K_ERROR("map %p va 0x%llx -> 0x%x\n", current_map(), (uint64_t)vm_map_trunc_page(load_result->entry_point, vm_map_page_mask(current_map())), kr);
 	}

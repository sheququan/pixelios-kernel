 		    (unsigned long long)codes[0], (unsigned long long)fault_addr,
@@ -1560,6 +1582,10 @@
 		    (unsigned long long)saved_state64(state)->x[1],
 		    sweet_arg,
 		    (unsigned long long)sweet_tbl[0], (unsigned long long)sweet_idx,
+		    (unsigned long long)sweet_dump[0], (unsigned long long)sweet_dump[1],
+		    (unsigned long long)sweet_dump[2], (unsigned long long)sweet_dump[3],
+		    (unsigned long long)sweet_dump[4], (unsigned long long)sweet_dump[5],
+		    (unsigned long long)sweet_dump[6], (unsigned long long)sweet_dump[7],

+/* R10: one build, several behaviours, picked by boot-arg ufsxnu=<bits>.
+ * Every candidate fix for "the host refuses every second command" is behind a
+ * bit so a single CI build can test them all by rebooting:
+ *   bit0 (1) acknowledge the completion (clear IS) after OCS, like the shim,
+ *            instead of right after the doorbell;
+ *   bit1 (2) write UTRLCLR for the slot after each completed command;
+ *   bit2 (4) re-arm the request list before every command (what 0153 does);
+ *   bit3 (8) 1 ms pause before every command.
+ * No boot-arg keeps 0153's behaviour (bit2). */
+static uint32_t ufs_xnu;
+
 static uint32_t ufs_seq;                /* commands submitted since boot */
 static uint32_t ufs_ok_seq;             /* last command that completed */
 static uint32_t ufs_ok_len;

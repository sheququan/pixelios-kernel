+/* SWEET (R36): direct physical-block read, bypassing HFS/cluster/UPL.
+ * F91-F103 showed the UFS driver always puts real instructions into the
+ * bounce buffer, but ubc_upl_commit_range() never turns those UPL pages into
+ * vm_object resident pages on SWEET, so every vn_rdwr()/copyin() sees zeroes.
+ * exec_prefault_data() resolves the file offset to a device block with
+ * VNOP_BLOCKMAP() and calls this instead; the resulting kernel page is wired
+ * into the new pmap with pmap_enter(). */
+int
+sweet_ufs_read_at(daddr64_t blkno, uint32_t bytes, void *dst)
+{
+	uint64_t pos;
+	uint64_t lba;
+	uint32_t skip;
+	uint32_t blocks;
+	int error;
+
+	if (dst == NULL || bytes == 0 || blkno < 0 || !su.nblocks) {
+		return EINVAL;
+	}
+	pos = (uint64_t)blkno * su.secsize;
+	lba = pos / UFS_BLOCK;
+	skip = (uint32_t)(pos % UFS_BLOCK);
+	blocks = (uint32_t)((skip + bytes + UFS_BLOCK - 1) / UFS_BLOCK);
+	if (blocks * UFS_BLOCK > BOUNCE_SIZE) {
+		return EINVAL;
+	}
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_read_blocks(su.first_block + lba, blocks);
+	if (!error) {
+		memcpy(dst, (const char *)(uintptr_t)(su.dma + DMA_BOUNCE) + skip,
+		    bytes);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}

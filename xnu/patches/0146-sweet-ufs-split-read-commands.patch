+/* The controller also gives up on a command that carries too many PRD entries:
+ * the 541 KiB /sbin/launchd read became one READ(10) with 68 x 8 KiB entries
+ * and never completed (0x28 timed out, bootBT), while every mount-time read
+ * with one or two entries finished. Cap one command at 8 entries = 64 KiB and
+ * loop instead. The bounce buffer, the strategy request size and every check
+ * in sweet_ufs_strategy() stay exactly as they are. */
+#define PRDT_CMD_ENTRIES  8u
+#define PRDT_CMD_BYTES    (PRDT_CMD_ENTRIES * PRDT_ENTRY_MAX)   /* 64 KiB */
+#define PRDT_CMD_BLOCKS   (PRDT_CMD_BYTES / UFS_BLOCK)          /* 16 blocks */
+_Static_assert(PRDT_CMD_BLOCKS > 0, "PRDT_CMD_BLOCKS must be non-zero");

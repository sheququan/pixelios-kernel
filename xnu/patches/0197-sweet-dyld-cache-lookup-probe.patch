+/*
+ * SWEET (R50): is dyld even looking for the shared cache?
+ *
+ * R49 proved the shared cache is never paged in (the largest file ever
+ * page-in'd is dyld itself, 0xe1520).  dyld therefore decided the cache was
+ * unusable before reading it.  These two probes separate the three possible
+ * reasons without guessing:
+ *   lookup probe fires, open probe fires  -> the file was found and opened,
+ *                                            so dyld read it and gave up later
+ *   only the lookup probe fires           -> name resolution failed (missing
+ *                                            file / permissions / VFS error)
+ *   neither probe fires                   -> dyld never even tried, the
+ *                                            decision is elsewhere
+ */
+static int sweet_dylldcache_lookup_seen;
+static int sweet_dyldcache_open_seen;
+
+static int
+sweet_name_has(const char *name, unsigned int len, const char *tag)
+{
+	unsigned int taglen = (unsigned int)strlen(tag);
+	unsigned int i;
+
+	if (len < taglen) {
+		return 0;
+	}
+	for (i = 0; i + taglen <= len; i++) {
+		if (memcmp(name + i, tag, taglen) == 0) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static int
+sweet_vnode_check_lookup(kauth_cred_t cred, struct vnode *dvp,
+    struct label *dlabel, struct componentname *cnp)
+{
+	(void)cred;
+	(void)dlabel;
+	if (!sweet_dylldcache_lookup_seen && cnp->cn_namelen > 4) {
+		const char *n = cnp->cn_nameptr;
+		unsigned int len = (unsigned int)cnp->cn_namelen;
+
+		if (sweet_name_has(n, len, "com.apple.dyld") ||
+		    sweet_name_has(n, len, "dyld_shared_cache")) {
+			char buf[64];
+			unsigned int copy = len < sizeof(buf) - 1 ? len : sizeof(buf) - 1;
+
+			memcpy(buf, n, copy);
+			buf[copy] = 0;
+			const char *dn = dvp ? vnode_getname(dvp) : NULL;
+
+			sweet_dylldcache_lookup_seen = 1;
+			printf("SWEET DYLD: lookup '%s' in '%s'\n", buf,
+			    dn ? dn : "?");
+			if (dn) {
+				vnode_putname(dn);
+			}
+			sweet_tr_event(2, len, 0);
+		}
+	}
+	return 0;
+}
+
+static int
+sweet_vnode_check_open(kauth_cred_t cred, struct vnode *vp,
+    struct label *label, int acc_mode)
+{
+	(void)cred;
+	(void)label;
+	if (!sweet_dyldcache_open_seen && vp != NULL) {
+		const char *n = vnode_getname(vp);
+
+		if (n != NULL &&
+		    sweet_name_has(n, (unsigned int)strlen(n), "dyld_shared_cache")) {
+			extern off_t ubc_getsize(struct vnode *);
+
+			sweet_dyldcache_open_seen = 1;
+			printf("SWEET DYLD: open '%s' acc %#x size %#llx\n",
+			    n, acc_mode, (unsigned long long)ubc_getsize(vp));
+			sweet_tr_event(3, (uint64_t)ubc_getsize(vp), (uint64_t)acc_mode);
+		}
+		if (n != NULL) {
+			vnode_putname(n);
+		}
+	}
+	return 0;
+}
+
 static const struct mac_policy_ops sweet_dyld_amfi_ops = {
 	.mpo_policy_syscall = sweet_dyld_amfi_syscall,
+	.mpo_vnode_check_lookup = sweet_vnode_check_lookup,
+	.mpo_vnode_check_open = sweet_vnode_check_open,
 };
 

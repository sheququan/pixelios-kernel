+/* Generic marker in the same ring (tag 2/3 used by the dyld probes). */
+void
+sweet_tr_event(uint32_t tag, uint64_t a, uint64_t b)
+{
+	struct sweet_tr_ent *e = &sweet_tr_ring[sweet_tr_head % SWEET_TR_MAX];
+
+	e->a = ((uint64_t)tag << 56) | (a & 0x00ffffffffffffffULL);
+	e->b = b;
+	sweet_tr_head++;
+}

+/* SWEET (R72): the entry page is re-read into a dedicated kernel buffer and
+ * wired manually with pmap_enter(); its final physical page differs from the
+ * one copyout() wrote.  Update the record so pmap_enter() only shouts about
+ * LATER takeovers, not about this expected re-wiring. */
+void
+sweet_wr_update_pn(uint64_t pg, uint32_t pn)
+{
+	int     i;
+
+	for (i = 0; i < sweet_wr_n && i < SWEET_WR_MAX; i++) {
+		if (sweet_wr_va[i] == pg) {
+			sweet_wr_pn[i] = pn;
+			return;
+		}
+	}
+}

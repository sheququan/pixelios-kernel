+/* SWEET (R72): every 16 KiB page the forced exec fill wrote, with the
+ * physical page copyout() went through and the first word written.
+ * pmap_enter() in osfmk/arm/pmap/pmap.c watches this table (range-guarded)
+ * and prints whenever one of these VAs is re-entered with a DIFFERENT
+ * physical page.  F133: the entry page reads real instructions at fill time
+ * and zero at SIGILL, yet SWEET ZPAGE counted NO page-in in between -- the
+ * only mechanism left is an object-resident zero page (F114: upl_commit
+ * creates resident zero pages) silently replacing the wired page through a
+ * later vm_fault, which never needs a cluster_pagein().  This table makes
+ * that takeover visible live, without depending on panic capture. */
+#define SWEET_WR_MAX 128
+uint64_t        sweet_wr_va[SWEET_WR_MAX];
+uint32_t        sweet_wr_pn[SWEET_WR_MAX];
+uint32_t        sweet_wr_w0[SWEET_WR_MAX];
+int             sweet_wr_n = 0;
+uint64_t        sweet_wr_min = ~0ULL;
+uint64_t        sweet_wr_max = 0;
+
+void
+sweet_wr_record(uint64_t pg, uint32_t w0)
+{
+	extern uint64_t kvtophys(vm_offset_t);
+	int     i;
+	uint32_t pn;
+
+	if (pg == 0 || (pg & (PAGE_SIZE - 1)) != 0) {
+		return;
+	}
+	for (i = 0; i < sweet_wr_n && i < SWEET_WR_MAX; i++) {
+		if (sweet_wr_va[i] == pg) {
+			return;
+		}
+	}
+	if (sweet_wr_n >= SWEET_WR_MAX) {
+		return;
+	}
+	pn = (uint32_t)(kvtophys((vm_offset_t)pg) >> PAGE_SHIFT);
+	sweet_wr_va[sweet_wr_n] = pg;
+	sweet_wr_pn[sweet_wr_n] = pn;
+	sweet_wr_w0[sweet_wr_n] = w0;
+	if (pg < sweet_wr_min) {
+		sweet_wr_min = pg;
+	}
+	if (pg > sweet_wr_max) {
+		sweet_wr_max = pg;
+	}
+	sweet_wr_n++;
+}
+
+void
+sweet_wr_reset(void)
+{
+	sweet_wr_n = 0;
+	sweet_wr_min = ~0ULL;
+	sweet_wr_max = 0;
+}

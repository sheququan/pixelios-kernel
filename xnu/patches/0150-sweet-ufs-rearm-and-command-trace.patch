--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -139,6 +139,16 @@
 static LCK_GRP_DECLARE(sweet_ufs_grp, "sweet_ufs");
 static LCK_MTX_DECLARE(sweet_ufs_lock, &sweet_ufs_grp);
 
+/* R7: a rejected command leaves the doorbell clear and OCS at its 0x0F preset,
+ * so the interesting question is what ran *before* it. bootCG mounted the root
+ * volume and then dropped the very next 4 KiB read, and the second boot got as
+ * far as "BSD root: ufsroot0" before the same thing happened, so every failure
+ * print carries the sequence number and the last command that completed. */
+static uint32_t ufs_seq;                /* commands submitted since boot */
+static uint32_t ufs_ok_seq;             /* last command that completed */
+static uint32_t ufs_ok_len;
+static uint32_t ufs_ok_nprd;
+
 static inline uint32_t
 ufs_rd(uint32_t off)
 {
@@ -207,6 +217,7 @@
 	 * WRITE(10) per request all stay unchanged; only the per-entry length shrinks. */
 	const uint32_t prdt_chunk = su.gs101 ? PRDT_CHUNK_GS : PRDT_ENTRY_MAX;
 	utrd->resp = (512u / gran) << 16 | (512u / gran);
+	uint32_t nprd = 0;
 	if (len) {
 		uint32_t n = 0;
 		for (uint32_t done = 0; done < len; done += prdt_chunk, n++) {
@@ -228,6 +239,7 @@
 		 * measured both encodings on one boot: DWORD count rc=0 (0.87 s
 		 * for 512 KiB), entry count rc=1 (timeout). */
 		utrd->prdt = (1024u / gran) << 16 | (su.gs101 ? 16 * n : 4 * n);
+		nprd = n;
 	}
 
 	if (su.cache) {
@@ -235,8 +247,9 @@
 		dma_clean(DMA_UCD, 16 + cdb_len);
 		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
 		if (len) {
-			/* gs201 stores the entry count; gs101 stores 16 * count (bytes). */
-			uint32_t prdt_n = (utrd->prdt & 0xffff) / (su.gs101 ? 16 : 1);
+			/* Both fields are in the granularity of the host: gs101 counts
+			 * bytes (16 * entries), gs201 counts DWORDs (4 * entries). */
+			uint32_t prdt_n = (utrd->prdt & 0xffff) / (su.gs101 ? 16 : 4);
 			dma_clean(DMA_UCD + offsetof(struct ucd, prdt),
 			    prdt_n * sizeof(ucd->prdt[0]));
 		}
@@ -315,6 +328,7 @@
 	}
 
 	uint32_t ocs = utrd->dw2 & 0xff;
+	ufs_seq++;
 	if (su.gs101 && ocs == 7 && (ucd->resp[6] || ucd->resp[7])) {
 		ocs = 0;        /* BROKEN_OCS_FATAL_ERROR: OCS 7 with a response present is a normal completion */
 	}
@@ -327,30 +341,56 @@
 	 * error - bootBW saw a good TUR rejected on residual 0x14. */
 	if (len == 0) {
 		if (ocs || ucd->resp[0] != 0x21) {
-			printf("SWEET UFS: no-data 0x%02x failed ocs 0x%x upiu 0x%x\n",
-			    cdb[0], ocs, ucd->resp[0]);
+			printf("SWEET UFS: no-data 0x%02x failed ocs 0x%x upiu 0x%x "
+			    "seq %u prev #%u len %u nprd %u dbr 0x%x is 0x%x hcs 0x%x\n",
+			    cdb[0], ocs, ucd->resp[0], ufs_seq, ufs_ok_seq, ufs_ok_len,
+			    ufs_ok_nprd, ufs_rd(REG_UTRLDBR), ufs_rd(REG_IS), ufs_rd(REG_HCS));
 			return EIO;
 		}
+		ufs_ok_seq = ufs_seq;
+		ufs_ok_len = 0;
+		ufs_ok_nprd = 0;
 		return 0;
 	}
 	if (ocs || ucd->resp[0] != 0x21 || ucd->resp[5] || ucd->resp[6] ||
 	    ucd->resp[7] || (residual && residual != 0xffffffffu)) {
 		printf("SWEET UFS: command 0x%02x failed: ocs 0x%x upiu 0x%x resp 0x%x "
-		    "status 0x%x residual 0x%x\n",
-		    cdb[0], ocs, ucd->resp[0], ucd->resp[4], ucd->resp[5], residual);
+		    "status 0x%x residual 0x%x seq %u len %u nprd %u prev #%u len %u "
+		    "nprd %u dbr 0x%x is 0x%x hcs 0x%x\n",
+		    cdb[0], ocs, ucd->resp[0], ucd->resp[4], ucd->resp[5], residual,
+		    ufs_seq, len, nprd, ufs_ok_seq, ufs_ok_len, ufs_ok_nprd,
+		    ufs_rd(REG_UTRLDBR), ufs_rd(REG_IS), ufs_rd(REG_HCS));
 		return EIO;
 	}
+	ufs_ok_seq = ufs_seq;
+	ufs_ok_len = len;
+	ufs_ok_nprd = nprd;
 	return 0;
 }
 
 /*
- * A reset (or the first command after take-over) leaves a pending UNIT
- * ATTENTION: the device accepts the doorbell but leaves OCS at its 0x0F
- * preset, so the command times out and every later command fails the same
- * way. bootCB / F51-F52 proved that one plain re-submission consumes the UA
- * and the SAME command then completes. Retry instead of failing the bio.
+ * R7: re-submitting is not enough. bootCD (R5) retried a rejected READ(10)
+ * three times and all three came back the same way - dbr 0x0, is 0x0, hcs 0xf,
+ * OCS still at its 0x0F preset - and bootCG shows the same after the mount
+ * succeeded. The host has to drop the request list and take ours again, which
+ * is what the shim's revive does before every retry (UTRLRSR 0 -> UTRLBA/BAU ->
+ * UTRLRSR 1). Do that between attempts instead of ringing the same list again.
  */
 #define UFS_MAX_TRIES  3u
+
+static void
+ufs_rearm_list(void)
+{
+	uint64_t list = su.dma_pa + DMA_UTRL;
+
+	ufs_wr(REG_UTRLRSR, 0);
+	ufs_wr(REG_UTRLBA, (uint32_t)list);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTRLRSR, 1);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));         /* drop any stale completion */
+	__builtin_arm_dsb(0xf);
+}
+
 static int
 ufs_scsi_at(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write,
     uint32_t bounce_off)
@@ -358,12 +398,17 @@
 	int error = 0;
 
 	for (unsigned attempt = 0; attempt < UFS_MAX_TRIES; attempt++) {
+		if (attempt) {
+			ufs_rearm_list();
+		}
 		error = ufs_scsi_once(cdb, cdb_len, len, write, bounce_off);
 		if (!error) {
 			return 0;
 		}
-		printf("SWEET UFS: retry 0x%02x attempt %u err %d len %u\n",
-		    cdb[0], attempt, error, len);
+		printf("SWEET UFS: retry 0x%02x attempt %u err %d len %u "
+		    "dbr 0x%x is 0x%x rsr 0x%x ba 0x%x hcs 0x%x\n",
+		    cdb[0], attempt, error, len, ufs_rd(REG_UTRLDBR), ufs_rd(REG_IS),
+		    ufs_rd(REG_UTRLRSR), ufs_rd(REG_UTRLBA), ufs_rd(REG_HCS));
 	}
 	return error;
 }

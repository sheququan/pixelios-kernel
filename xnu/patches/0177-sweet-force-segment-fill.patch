+/* SWEET (R30): record every file-backed Mach-O segment while load_segment()
+ * still has both the vnode and the (already slid) mapping addresses.
+ * exec_prefault_data() later writes the file contents into the new address
+ * space with copyout(), bypassing the UPL -> vm_object -> pmap gap that makes
+ * every text page read back as zeroes (F91-F97).  Single CPU at boot, so a
+ * plain global array is sufficient. */
+#define SWEET_MAX_SEGS 32
+uint64_t        sweet_seg_va[SWEET_MAX_SEGS];
+uint64_t        sweet_seg_off[SWEET_MAX_SEGS];
+uint64_t        sweet_seg_len[SWEET_MAX_SEGS];
+struct vnode   *sweet_seg_vp[SWEET_MAX_SEGS];
+int             sweet_seg_count = 0;
+
 /* An empty load_result_t */
 static const load_result_t load_result_null = {
 	.mach_header = MACH_VM_MIN_ADDRESS,
@@ -2386,6 +2399,20 @@

+			sweet_seg_len[sweet_seg_count] =
+			    (uint64_t)(file_end - file_start);
+			sweet_seg_vp[sweet_seg_count] = vp;
+			sweet_seg_count++;
+		}
 		/*
 		 *	Map a copy of the file into the address space.

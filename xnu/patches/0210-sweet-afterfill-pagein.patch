+/*
+ * SWEET (R70): page-ins that happen *after* the forced fill.
+ *
+ * R66/R67 fixed the fill (F130) and launchd got further: it now dies with
+ * SIGILL on dyld __TEXT+0x13c00, an instruction word of 00000000 -- i.e. a
+ * page that the fill had written came back as zeroes.  The only thing that can
+ * do that is the normal pager touching the page afterwards, so count and keep
+ * the first/last of those page-ins.  The panic prints this without any console
+ * I/O of its own.
+ */
+static int sweet_fill_done;
+static unsigned int sweet_pf_after;
+static uint64_t sweet_pf_first_fs, sweet_pf_first_off;
+static uint64_t sweet_pf_last_fs, sweet_pf_last_off;
+
+void
+sweet_tr_fill_done(void)
+{
+	sweet_fill_done = 1;
+	sweet_tr_event(4, 0, 0);
+}
+
+void
+sweet_tr_pagein_after(uint64_t filesize, uint64_t f_offset)
+{
+	if (!sweet_fill_done) {
+		return;
+	}
+	if (sweet_pf_after == 0) {
+		sweet_pf_first_fs = filesize;
+		sweet_pf_first_off = f_offset;
+	}
+	sweet_pf_last_fs = filesize;
+	sweet_pf_last_off = f_offset;
+	sweet_pf_after++;
+	sweet_tr_event(5, filesize, f_offset);
+}
+
+void
+sweet_tr_after_format(char *out, unsigned long outlen)
+{
+	snprintf(out, outlen,
+	    "SWEET ZPAGE: afterfill %u first fs %#llx off %#llx last fs %#llx off %#llx\n",
+	    sweet_pf_after,
+	    (unsigned long long)sweet_pf_first_fs,
+	    (unsigned long long)sweet_pf_first_off,
+	    (unsigned long long)sweet_pf_last_fs,
+	    (unsigned long long)sweet_pf_last_off);
+}
+
 /* Render the summary into a buffer; never touches the console itself. */
 void
 sweet_tr_format(char *out, unsigned long outlen)

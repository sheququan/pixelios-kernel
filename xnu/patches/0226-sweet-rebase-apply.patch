+
+#define RB_DYLD_SIZE    0xE1520ULL  /* /usr/lib/dyld on this rootfs */
+#define RB_LAUNCHD_SIZE 0x843a0ULL  /* /sbin/launchd on this rootfs */
+
+extern uint64_t sweet_seg_va[], sweet_seg_off[], sweet_seg_len[];
+extern struct vnode *sweet_seg_vp[];
+extern int sweet_seg_count;
+extern uint64_t kvtophys(uint64_t);
+extern uint64_t phystokv(uint64_t);
+extern void sweet_objfill(uint64_t, uint64_t, const void *, uint32_t);
+
+/*
+ * Apply one file's table.  base is the VA of the file's file-offset-0
+ * segment; entry k writes base + tgt at the VA that maps file offset
+ * off.  The write goes through the physmap alias of the already-wired
+ * page and is cleaned to the point of coherency; sweet_objfill mirrors
+ * it into every resident object page covering the offset.
+ */
+static void
+sweet_rebase_one(const struct sweet_rbent *tbl, int n, struct vnode *fvp,
+    uint64_t base, int *wrotep, int *badpap)
+{
+	int k;
+
+	for (k = 0; k < n; k++) {
+		uint64_t foff = tbl[k].off;
+		uint64_t uva = 0;
+		int si, found = 0;
+
+		for (si = 0; si < sweet_seg_count && si < 32; si++) {
+			uint64_t sva = sweet_seg_va[si];
+			uint64_t soff = sweet_seg_off[si];
+			uint64_t slen = sweet_seg_len[si];
+
+			if (sweet_seg_vp[si] != fvp || foff < soff ||
+			    foff >= soff + slen) {
+				continue;
+			}
+			uva = sva + (foff - soff);
+			found = 1;
+			break;
+		}
+		if (!found) {
+			continue;
+		}
+		{
+			uint64_t pa = kvtophys(uva &
+			    ~(uint64_t)(PAGE_SIZE - 1));
+			uint64_t val = base + tbl[k].tgt;
+
+			if (pa != 0 && pa < 0x10000000000ULL) {
+				uint64_t kva = phystokv(pa) +
+				    (uva & (PAGE_SIZE - 1));
+
+				*(volatile uint64_t *)(uintptr_t)kva = val;
+				__asm__ volatile("dc civac, %0" :: "r"(kva) :
+				    "memory");
+				(*wrotep)++;
+				sweet_objfill(uva,
+				    (uint64_t)(uintptr_t)current_map(),
+				    (const void *)&val, sizeof(val));
+			} else {
+				(*badpap)++;
+			}
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * Called from the exec fill path right after the fill verification
+ * prints, before the entry-page pmap switch.  Groups the recorded
+ * segments by vnode, finds each file's base (the VA of its file-
+ * offset-0 segment) and applies the matching table.
+ */
+void
+sweet_rebase_apply(void)
+{
+	int si, done = 0, nd = 0, nl = 0, wrote = 0, badpa = 0;
+	uint64_t base_d = 0, base_l = 0;
+	struct vnode *vp_d = NULL, *vp_l = NULL;
+
+	for (si = 0; si < sweet_seg_count && si < 32; si++) {
+		struct vnode *vp = sweet_seg_vp[si];
+		off_t fsz;
+
+		if (vp == NULL || sweet_seg_off[si] != 0) {
+			continue;
+		}
+		fsz = ubc_getsize(vp);
+		if (fsz == (off_t)RB_DYLD_SIZE) {
+			vp_d = vp;
+			base_d = sweet_seg_va[si];
+			done |= 1;
+		} else if (fsz == (off_t)RB_LAUNCHD_SIZE) {
+			vp_l = vp;
+			base_l = sweet_seg_va[si];
+			done |= 2;
+		}
+	}
+	if ((done & 1) && vp_d != NULL && base_d != 0) {
+		int w0 = 0, b0 = 0;
+
+		sweet_rebase_one(sweet_rb_dyld,
+		    (int)(sizeof(sweet_rb_dyld) / sizeof(sweet_rb_dyld[0])),
+		    vp_d, base_d, &w0, &b0);
+		wrote += w0;
+		badpa += b0;
+		nd = 1;
+	}
+	if ((done & 2) && vp_l != NULL && base_l != 0) {
+		int w0 = 0, b0 = 0;
+
+		sweet_rebase_one(sweet_rb_launchd,
+		    (int)(sizeof(sweet_rb_launchd) /
+		    sizeof(sweet_rb_launchd[0])),
+		    vp_l, base_l, &w0, &b0);
+		wrote += w0;
+		badpa += b0;
+		nl = 1;
+	}
+	printf("SWEET REBASE: d%d l%d wrote %d badpa %d\n",
+	    nd, nl, wrote, badpa);
+	/* Verify the crash slot: dyld file 0x80098 must now hold
+	 * base + 0x3607c (the null-import stub). */
+	if (nd && base_d != 0) {
+		uint32_t g[2] = { 0, 0 };
+		int ci;
+		uint64_t want = base_d + 0x3607c;
+
+		ci = copyin((user_addr_t)(base_d + 0x80098), (char *)g,
+		    sizeof(g));
+		printf("SWEET REBASE: vt38 %08x %08x want %08x %08x ci %d\n",
+		    g[0], g[1],
+		    (uint32_t)want, (uint32_t)(want >> 32), ci);
+	}
+}

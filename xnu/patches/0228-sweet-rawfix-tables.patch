+/*
+ * SWEET (R88 / F144): the zero-chunk workaround, take two.
+ *
+ * F142's rebase table repaired the pointer slots, and R86 then ran dyld
+ * far enough to launch the embedded libignition ("Darwin Ignition
+ * Sequence", statically linked into /usr/lib/dyld).  The ignition runner
+ * panicked with "stage did not set payload: hello": the hello stage's
+ * struct (file 0x809d8) has its "payload optional" flag at file 0x809f8,
+ * which is 0xffffffffffffffff on disk, but the runner only panics when
+ * that flag reads zero at runtime -- so the raw (non-pointer) half of
+ * the segment came back as zeroes, exactly like the slots did in F142.
+ * The disk->memory fill loses whole 4 KiB chunks (F127/F130/F139: the
+ * block map, not the device, is wrong), and only the first word of each
+ * chunk was ever verified (FILL3 blind spot).
+ *
+ * This table lists every non-zero 8-byte word of dyld's __DATA_CONST /
+ * __DATA / __DATA_DIRTY (file 0x80000..0x90000) and launchd's
+ * __DATA_CONST / __DATA (file 0x68000..0x74000) that is NOT a chained
+ * pointer slot (those are in the rebase tables).  sweet_rebase_apply()
+ * writes these literal values right after the rebase pass, through the
+ * same physmap-alias + civac + sweet_objfill path, so the segments are
+ * bit-exact with the files regardless of the broken chunk reads.
+ */
+struct sweet_rwent {               /* raw (literal) data word */
+	uint32_t off;              /* file offset */
+	uint64_t val;              /* on-disk value */
+};

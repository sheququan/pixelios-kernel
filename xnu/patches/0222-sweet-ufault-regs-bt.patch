+		/*
+		 * SWEET (R82): the fault is pc=0 lr=0 -- a br/ret forwarded a
+		 * NULL pointer, so lr will never name the caller.  Dump the
+		 * remaining integer registers (x16/x17 are the usual indirect
+		 * branch targets) and walk the frame-pointer chain, the only
+		 * record of the call stack left.  Guard every copyin address
+		 * like the R58 table read; see F126.
+		 */
+		uint64_t sweet_regs[8] = { 0 };
+		sweet_regs[0] = saved_state64(state)->x[16];
+		sweet_regs[1] = saved_state64(state)->x[17];
+		sweet_regs[2] = saved_state64(state)->x[19];
+		sweet_regs[3] = saved_state64(state)->x[21];
+		sweet_regs[4] = saved_state64(state)->x[22];
+		sweet_regs[5] = saved_state64(state)->x[25];
+		sweet_regs[6] = saved_state64(state)->fp;
+		sweet_regs[7] = saved_state64(state)->sp;
+		uint64_t sweet_bt[12] = { 0 };
+		{
+			int sweet_btn = 0;
+			uint64_t sweet_fp = saved_state64(state)->fp;
+
+			for (int i = 0; i < 6 && sweet_btn < 12; i++) {
+				uint64_t fr[2] = { 0, 0 };
+
+				if (sweet_fp < 0x1000ULL ||
+				    sweet_fp >= 0x0000800000000000ULL) {
+					break;
+				}
+				COPYIN(sweet_fp, (char *)fr, sizeof(fr));
+				sweet_bt[sweet_btn++] = sweet_fp;
+				sweet_bt[sweet_btn++] = fr[1];
+				sweet_fp = fr[0];
+			}
+		}

+					/* SWEET (R76): 0215 cleaned the whole 16 KiB
+					 * page at RECORD time, i.e. right after
+					 * chunk 0's copyout and BEFORE chunks 1..3
+					 * were written -- only the first 4 KiB ever
+					 * reached L2, and the first fetch past it
+					 * executed zeros (R75 SIGILL at page offset
+					 * 0x1c00; every observed pc sits past the
+					 * first sub-page).  Clean THIS chunk's
+					 * exact pa range now, after its copyout,
+					 * through the physmap alias (kernel VA). */
+					{
+						extern uint64_t phystokv(uint64_t);
+						extern uint64_t kvtophys(uint64_t);
+						uint64_t cpa = kvtophys((uint64_t)(va + pos));
+						uint64_t cl2, span = (uint64_t)n + (cpa & 63);
+
+						cpa &= ~(uint64_t)63;
+						if ((cpa >> 60) != 0) {
+							uint64_t kva = phystokv(cpa);
+
+							for (cl2 = 0; cl2 < span; cl2 += 64) {
+								__asm__ volatile("dc cvac, %0" :: "r"(kva + cl2) : "memory");
+							}
+							__asm__ volatile("dsb sy" ::: "memory");
+						}
+					}
 					filled++;
 					pos += n;
 				}
